\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Historical shock decomposition of French HICP inflation in deviation from target (1999Q2--2025Q3). The 2022 surge is captured by the residual monetary shock rather than by the cost-push shock, illustrating the identification limit discussed in the text.\relax }}{8}{figure.caption.11}\protected@file@percent }
\newlabel{fig:histdecomp}{{4}{8}{Historical shock decomposition of French HICP inflation in deviation from target (1999Q2--2025Q3). The 2022 surge is captured by the residual monetary shock rather than by the cost-push shock, illustrating the identification limit discussed in the text.\relax }{figure.caption.11}{}}
